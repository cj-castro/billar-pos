# =============================================================================
# .env.example
# Phase 3 - Non-secret environment configuration template
#
# This file documents every NON-SECRET configuration variable the backend,
# scheduler, and telegram-bot processes read. Real SECRET values (passwords,
# JWT keys, the Telegram bot token, SMTP credentials, etc.) are NOT stored
# here — once scripts/migrate-secrets-to-dpapi.ps1 (Plan 03-03) has run on a
# machine, those values are sourced from Windows Credential Manager / DPAPI
# instead of from a .env file. See the "Secrets" section at the bottom of
# this file for the full list and where each one now lives.
#
# For local Docker development: copy this file to `.env` and fill in real
# values for the secrets section too — Docker Compose dev does not use
# Credential Manager, it reads everything from `.env` (see docker-compose.yml).
#
#   cp .env.example .env
#
# For native Windows Services (staging/production, Phase 2+3): only this
# file's non-secret values apply via the install scripts' Read-DotEnv
# helper; secrets are migrated separately via migrate-secrets-to-dpapi.ps1.
# =============================================================================

# ── Postgres (non-secret) ───────────────────────────────────────────────────
POSTGRES_DB=billiardbar
POSTGRES_USER=billiard
# POSTGRES_PASSWORD is a secret — see "Secrets" section below.

# ── Backend business config ─────────────────────────────────────────────────
BILLING_MODE=PER_MINUTE
POOL_RATE_CENTS=150
HAPPY_HOUR_START=17:00
HAPPY_HOUR_END=20:00
HAPPY_HOUR_DISCOUNT_PCT=20
CURRENCY=MXN
TZ=America/Mexico_City

# ── App/runtime defaults ────────────────────────────────────────────────────
LOG_LEVEL=INFO
JWT_ACCESS_HOURS=8
RATELIMIT_STORAGE_URI=memory://
FLASK_ENV=production

# ── Print agent (Windows-hosted, outside Docker) ────────────────────────────
# 127.0.0.1, not localhost: under the native Windows Services hosting model,
# eventlet.monkey_patch() (DATA-03) breaks Python-level "localhost" DNS
# resolution on Windows (confirmed Phase 4 04-04 staging validation) — an IP
# literal avoids the DNS lookup entirely. On Docker deployments where the
# print agent runs on the host, override this to http://host.docker.internal:9191.
PRINT_AGENT_URL=http://127.0.0.1:9191

# ── Frontend / networking ───────────────────────────────────────────────────
FRONTEND_PORT=8080

# ── Daily email report recipients (non-secret; operator-specific) ──────────
REPORT_FROM=CHANGE_ME@example.com
REPORT_TO=CHANGE_ME@example.com

# ── Telegram bot (non-secret half; token itself is a secret, see below) ────
# Numeric Telegram chat id the bot posts operational alerts to.
ADMIN_CHAT_ID=CHANGE_ME

# =============================================================================
# Secrets (SEC-01 scope, D-07) — NOT set here.
#
# On staging/production (Windows Services), these values are migrated into
# Windows Credential Manager / DPAPI by scripts/migrate-secrets-to-dpapi.ps1
# and injected into each NSSM service's AppEnvironmentExtra at
# service-configuration time — they are never read from this file there.
#
# For local Docker development ONLY, uncomment and fill in real values in
# your own `.env` (never commit that file):
# =============================================================================

# POSTGRES_PASSWORD=       <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# SECRET_KEY=               <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# JWT_REFRESH_SECRET=       <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# ADMIN_PASSWORD=           <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# ADMIN_PIN=                <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# MANAGER_PASSWORD=         <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# MANAGER_PIN=              <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# WAITER1_PASSWORD=         <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# WAITER2_PASSWORD=         <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# KITCHEN_PASSWORD=         <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# BARSTAFF_PASSWORD=        <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# SMTP_HOST=                <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# SMTP_PORT=                <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# SMTP_USER=                <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# SMTP_PASSWORD=            <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
# TELEGRAM_TOKEN=           <- sourced from Credential Manager, see scripts/migrate-secrets-to-dpapi.ps1
